compiler:
  target: static
  compiler_style: gcc
  compiler_exe: gcc
  linker_exe: ar

directories:
  project_dir: .
  exe_path_name: bin/libsns.a
  include_dirs: [include, include/generated]
  source_dirs: [src]
  temp_dir: obj

default:
  libraries_dirs: []
  libraries_names: [netTcpSslDebug, logger]
  linker_args: rcs
  scripts:
    pre: transplate.sh

debug:
  compiler_args: -ggdb3 -std=c23 -Wall -Wconversion -Wshadow -Wextra -Wuninitialized -Wimplicit-fallthrough=5 -Wmisleading-indentation -Wstrict-overflow=5 -Wstringop-overflow=4 -Wunknown-pragmas -Wsuggest-attribute=pure -Wsuggest-attribute=cold -Wsuggest-attribute=noreturn -Wsuggest-attribute=const -Wsuggest-attribute=format -Wsuggest-attribute=malloc -Wstrict-aliasing -Wbad-function-cast -Wcast-qual -Wcast-align -Wcast-function-type -Wwrite-strings -Wlogical-op -fstack-protector-strong -fstrict-aliasing -fsanitize=address -fsanitize=leak -fsanitize=undefined -pthread -D_POSIX_C_SOURCE=200809L

analyze:
  compiler_args: -ggdb3 -std=c23 -Wno-unknown-pragmas -Wall -Wconversion -Wshadow -Wextra -pthread -fanalyzer -D_POSIX_C_SOURCE=200809L
  libraries_names: [netTcpSslDebugNoAsan, logger]

no-asan:
  compiler_args: -ggdb3 -std=c23 -Wno-unknown-pragmas -Wall -Wconversion -Wshadow -Wextra -pthread -D_POSIX_C_SOURCE=200809L

no-threads:
  compiler_args: -ggdb3 -std=c23 -Wno-unknown-pragmas -Wall -Wconversion -DNO_THREADING -Wshadow -Wextra -fsanitize=address -fsanitize=leak -D_POSIX_C_SOURCE=200809L

extra: 
  compiler_args: -Wpadded -D_POSIX_C_SOURCE=200809L

release:
  compiler_args: -Ofast -DNDEBUG -g3 -std=c23 -pthread -D_POSIX_C_SOURCE=200809L
  libraries_names: [netTcpSsl, logger]
